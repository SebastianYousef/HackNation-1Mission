{
  "center": "ATLAS:mech-lysosomal-degradation",
  "nodes": [
    {
      "id": "ATLAS:mech-lysosomal-degradation",
      "type": "mechanism",
      "subtype": "biological_process",
      "label": "Lysosomal degradation (ceroid lipofuscin storage)",
      "summary": "Cells break down worn-out parts inside lysosomes. In all NCLs this recycling fails and waste (lipofuscin) builds up, especially in nerve cells."
    },
    {
      "id": "MONDO:MOCK0002",
      "type": "disease",
      "subtype": null,
      "label": "CLN2 disease",
      "summary": "A form of Batten disease that starts in toddlers with seizures and loss of skills. An enzyme replacement therapy is approved."
    },
    {
      "id": "MONDO:MOCK0003",
      "type": "disease",
      "subtype": null,
      "label": "CLN3 disease",
      "summary": "The most common form of Batten disease. It usually starts at school age with vision loss, followed by seizures and loss of skills."
    },
    {
      "id": "MONDO:MOCK0005",
      "type": "disease",
      "subtype": null,
      "label": "CLN5 disease",
      "summary": "A very rare inherited childhood brain disease that causes vision loss, seizures and loss of skills. There is no approved treatment yet."
    },
    {
      "id": "MONDO:MOCK0006",
      "type": "disease",
      "subtype": null,
      "label": "CLN6 disease",
      "summary": "A rare inherited brain disease of childhood with seizures, vision loss and loss of movement and speech skills."
    },
    {
      "id": "MONDO:MOCK0099",
      "type": "disease",
      "subtype": null,
      "label": "MOCK ultra-rare NCL subtype X (fictional)",
      "summary": "A FICTIONAL, made-up ultra-rare Batten-like disease used to demo the 'no known group' case. Not a real diagnosis."
    },
    {
      "id": "HGNC:MOCK0003",
      "type": "gene",
      "subtype": "protein_coding",
      "label": "CLN3",
      "summary": "Makes a protein that sits in the lysosome's outer membrane."
    },
    {
      "id": "HGNC:MOCK0005",
      "type": "gene",
      "subtype": "protein_coding",
      "label": "CLN5",
      "summary": "Makes a soluble protein that works inside the lysosome; its exact job is still being studied."
    },
    {
      "id": "HGNC:MOCK0006",
      "type": "gene",
      "subtype": "protein_coding",
      "label": "CLN6",
      "summary": "Makes a protein in the cell's endoplasmic reticulum membrane that helps deliver enzymes to lysosomes."
    },
    {
      "id": "HGNC:MOCK0007",
      "type": "gene",
      "subtype": "protein_coding",
      "label": "MFSD8",
      "summary": "Makes a lysosomal membrane transporter; changes cause CLN7 disease."
    },
    {
      "id": "HGNC:MOCK0001",
      "type": "gene",
      "subtype": "protein_coding",
      "label": "PPT1",
      "summary": "Makes a soluble lysosomal enzyme; changes cause CLN1 disease."
    },
    {
      "id": "HGNC:MOCK0002",
      "type": "gene",
      "subtype": "protein_coding",
      "label": "TPP1",
      "summary": "Makes TPP1, a soluble lysosomal enzyme that breaks down small proteins. Missing in CLN2 disease."
    },
    {
      "id": "GRANT:MOCK0001",
      "type": "grant",
      "subtype": null,
      "label": "[MOCK] Lysosomal dysfunction across CLN subtypes",
      "summary": "A (mock) research grant comparing how lysosomes fail in different forms of Batten disease."
    },
    {
      "id": "DRUG:MOCK0001",
      "type": "intervention",
      "subtype": "enzyme_replacement",
      "label": "Cerliponase alfa",
      "summary": "A manufactured TPP1 enzyme given into the brain fluid. It is approved for CLN2 disease only."
    },
    {
      "id": "PERSON:mock-researcher-b",
      "type": "person",
      "subtype": "researcher",
      "label": "Dr. B. Placeholder",
      "summary": "(Fictional) cell biologist working on lysosomal membrane proteins, especially CLN3."
    }
  ],
