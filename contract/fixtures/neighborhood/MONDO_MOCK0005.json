{
  "center": "MONDO:MOCK0005",
  "nodes": [
    {
      "id": "MONDO:MOCK0005",
      "type": "disease",
      "subtype": null,
      "label": "CLN5 disease",
      "summary": "A very rare inherited childhood brain disease that causes vision loss, seizures and loss of skills. There is no approved treatment yet."
    },
    {
      "id": "ASSET:mock-cln5-sheep-model",
      "type": "asset",
      "subtype": "animal_model",
      "label": "CLN5 sheep model (mock entry)",
      "summary": "A large-animal model with CLN5 changes that researchers use to test treatments. [MOCK record]"
    },
    {
      "id": "MONDO:MOCK0002",
      "type": "disease",
      "subtype": null,
      "label": "CLN2 disease",
      "summary": "A form of Batten disease that starts in toddlers with seizures and loss of skills. An enzyme replacement therapy is approved."
    },
    {
      "id": "MONDO:MOCK0003",
      "type": "disease",
      "subtype": null,
      "label": "CLN3 disease",
      "summary": "The most common form of Batten disease. It usually starts at school age with vision loss, followed by seizures and loss of skills."
    },
    {
      "id": "MONDO:MOCK0006",
      "type": "disease",
      "subtype": null,
      "label": "CLN6 disease",
      "summary": "A rare inherited brain disease of childhood with seizures, vision loss and loss of movement and speech skills."
    },
    {
      "id": "MONDO:MOCK0099",
      "type": "disease",
      "subtype": null,
      "label": "MOCK ultra-rare NCL subtype X (fictional)",
      "summary": "A FICTIONAL, made-up ultra-rare Batten-like disease used to demo the 'no known group' case. Not a real diagnosis."
    },
    {
      "id": "MONDO:MOCK0000",
      "type": "disease",
      "subtype": null,
      "label": "Neuronal ceroid lipofuscinosis",
      "summary": "A group of inherited brain diseases (often called Batten disease) in which waste material builds up inside cells' recycling centres, the lysosomes."
    },
    {
      "id": "HGNC:MOCK0005",
      "type": "gene",
      "subtype": "protein_coding",
      "label": "CLN5",
      "summary": "Makes a soluble protein that works inside the lysosome; its exact job is still being studied."
    },
    {
      "id": "ATLAS:mech-lysosomal-degradation",
      "type": "mechanism",
      "subtype": "biological_process",
      "label": "Lysosomal degradation (ceroid lipofuscin storage)",
      "summary": "Cells break down worn-out parts inside lysosomes. In all NCLs this recycling fails and waste (lipofuscin) builds up, especially in nerve cells."
    },
    {
      "id": "ATLAS:mech-soluble-lysosomal-enzyme-deficiency",
      "type": "mechanism",
      "subtype": "variant_effect",
      "label": "Soluble lysosomal enzyme deficiency",
      "summary": "A missing enzyme that normally floats free inside the lysosome. Because it is soluble, it can sometimes be replaced with a manufactured version (enzyme replacement)."
    },
    {
      "id": "ORG:mock-bdsra",
      "type": "organization",
      "subtype": "patient_group",
      "label": "Batten Disease Support, Research and Advocacy Association (BDSRA)",
      "summary": "A patient advocacy organization supporting families affected by all forms of Batten disease. [MOCK record: details are placeholders]"
    },
    {
      "id": "ORG:mock-cln5-families",
      "type": "organization",
      "subtype": "patient_group",
      "label": "CLN5 Families Network (mock)",
      "summary": "A (fictional) parent-led group for families affected by CLN5 disease."
    },
    {
      "id": "PERSON:mock-researcher-a",
      "type": "person",
      "subtype": "researcher",
      "label": "Dr. A. Example",
      "summary": "(Fictional) neuroscientist studying lysosomal storage in CLN5 and CLN3 disease."
    },
    {
      "id": "HP:MOCK0003",
      "type": "phenotype",
      "subtype": null,
      "label": "Ataxia",
      "summary": "Unsteady, clumsy movement and walking."
    },
    {
      "id": "HP:MOCK0006",
      "type": "phenotype",
      "subtype": null,
      "label": "Cerebral atrophy",
      "summary": "Shrinking of brain tissue seen on a brain scan."
    },
    {
      "id": "HP:MOCK0004",
      "type": "phenotype",
      "subtype": null,
      "label": "Developmental regression",
      "summary": "Losing skills (speech, walking, learning) that a child had already gained."
    },
    {
      "id": "HP:MOCK0005",
      "type": "phenotype",
      "subtype": null,
      "label": "Myoclonus",
      "summary": "Brief, jerky, involuntary muscle twitches."
    },
    {
      "id": "HP:MOCK0001",
      "type": "phenotype",
      "subtype": null,
      "label": "Seizure",
      "summary": "Sudden bursts of abnormal electrical activity in the brain (fits)."
    },
    {
      "id": "HP:MOCK0002",
      "type": "phenotype",
      "subtype": null,
      "label": "Visual loss",
      "summary": "Gradual loss of eyesight."
    },
    {
      "id": "PMID:MOCK0001",
      "type": "publication",
      "subtype": null,
      "label": "[MOCK] Shared lysosomal storage features in CLN5 and CLN6 disease",
      "summary": "A (mock) paper comparing storage material and symptoms in CLN5 and CLN6 disease."
    }
  ],
