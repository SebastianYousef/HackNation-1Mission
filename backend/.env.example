# Copy to backend/.env (gitignored). Read by the API and worker (pydantic-settings:
# backend/.env, then ./.env; real env vars win) and by infra/docker-compose.yml
# (env_file). Never commit real values.

# --- data source -------------------------------------------------------------
# fixtures = serve contract/fixtures/*.json (no DB needed); db = call the api_* SQL functions.
DATA_MODE=fixtures
# In fixtures mode, serve these endpoints from Postgres anyway (switch one by one):
# meta,search,node,neighborhood,edge,similar,paths,clusters,cluster,action_view,
# mechanism_view,explain,outreach,gap_search,submissions
DB_ENDPOINTS=
# Where fixture JSON lives (default: <repo>/contract/fixtures; /app/contract/fixtures in Docker)
# FIXTURES_DIR=

# --- Postgres -----------------------------------------------------------------
# Any Postgres 16+ with pg_trgm and pgvector (no deployment uses Supabase). For
# `make api-dev` or the pipeline against the compose `db` service, from the host:
# DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas
# Leave it unset for `make up` (containers default to the `db` service; localhost
# doesn't resolve to it from inside a container). A transaction pooler (PgBouncer,
# Supavisor) in front is fine: prepared statements are disabled in code.
DATABASE_URL=
# Connections per API process. Budget: replicas x WEB_CONCURRENCY x DB_POOL_SIZE <= pooler limit.
DB_POOL_SIZE=5

# --- Redis (shared cache, rate-limit counters, job queue) -----------------------
# Unset = in-process cache + in-process jobs (single-process dev only).
REDIS_URL=
# How long a finished/failed gap-search job stays pollable at GET /jobs/{id}, seconds.
# ("running" expires after 120 s on its own, so a job whose worker died becomes a 404.)
JOB_TTL_SECONDS=3600

# --- AI (POST /explain, /outreach-draft) ----------------------------------------
# Missing key -> those endpoints return 503 upstream_unavailable (fixtures mode serves the fixture).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Pipeline only: reconcile embeddings + the spend cap (embedding spend is counted in openai_usage.json).
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_BUDGET_USD=7
# Per client IP, per minute. Applies to explain+outreach together; gap-search and
# submissions each have their own bucket with the same limit.
AI_RATE_LIMIT_PER_MINUTE=10

# --- Bright Data SERP API (POST /gap-search, run by the worker) -----------------
# Missing key -> the job ends "failed" with "web search is not configured".
BRIGHTDATA_API_KEY=
# Zone used for POST https://api.brightdata.com/request {zone, url, format:"raw"} with a
# Google URL + brd_json=1. A SERP API zone works, and so does a Web Unlocker zone: the
# Web Unlocker also serves Google SERP (verified with a zone named mcp_unlocker).
# A wrong zone shows up as a failed job whose error carries Bright Data's x-brd-err-code.
BRIGHTDATA_SERP_ZONE=serp_api1
# Bright Data Scraping Browser (JS-heavy patient-org sites via Playwright/Puppeteer).
# The zone IP allowlist must contain the PUBLIC IP of the machine that connects (not a 100.x Tailscale IP).
BRIGHTDATA_BROWSER_USER=
BRIGHTDATA_BROWSER_PASSWORD=
# Format: wss://<user>:<password>@brd.superproxy.io:9222. Leave empty to skip the browser
# (a placeholder here would make the pipeline try to connect with it).
BRIGHTDATA_BROWSER_WSS=

# --- HTTP ---------------------------------------------------------------------
# Comma list; '*' wildcard allowed in the host (localhost on any port and https://sebastianyousef.github.io are always allowed).
CORS_ORIGINS=
# Shown in the X-Served-By response header. Default: hostname (= container id in Docker).
# INSTANCE_ID=api-1
LOG_LEVEL=INFO
# Response cache TTL (Redis/in-process), seconds.
CACHE_TTL_SECONDS=300
# On SIGTERM, /readyz answers 503 for this long before shutdown so the LB drains us.
SHUTDOWN_GRACE_SECONDS=0
# How many reverse proxies in front of the API append to X-Forwarded-For. The client IP
# (rate limits, access log) is the XFF entry this many hops from the RIGHT, so a value
# the client sends itself is never trusted. 1 = behind our L7 HAProxy (compose,
# lb-native); 0 = API exposed directly (use the socket peer, ignore XFF); on a PaaS
# (Cloud Run, Render, ...) set it to the number of proxies the platform adds.
TRUSTED_PROXY_HOPS=1
# Largest accepted request body, bytes; bigger POSTs get a 413 ApiError before parsing.
MAX_BODY_BYTES=65536
