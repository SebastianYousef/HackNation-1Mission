# ~/atlas-server/.env on the GPU workstation (created by setup.sh; chmod 600). Never commit.

# This machine's Tailscale IPv4 (`tailscale ip -4`), e.g. 100.87.219.50
TS_IP=

# Local Postgres (container). Pick a long random password.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://atlas:${POSTGRES_PASSWORD}@db:5432/atlas

DATA_MODE=db
API_REPLICAS=4
WEB_CONCURRENCY=2
# Public Funnel URL + Lovable preview origins
CORS_ORIGINS=https://*.ts.net,https://*.lovable.app,https://*.lovableproject.com

# AI (only the API's /explain + /outreach-draft use this; hosted OpenAI keeps the prize track visible)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=serp_api1

# Built frontend (Vite dist/) served by the `web` containers
WEB_DIST=/home/CHANGE_ME/atlas-server/web-dist
